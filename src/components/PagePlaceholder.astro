---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { UiKey } from '../i18n/ui';

interface Props {
  /** Translation key used for the page title (e.g. 'nav.about'). */
  titleKey: UiKey;
}

const { titleKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const title = t(titleKey);
---

<BaseLayout title={title}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="border-l-4 border-brand-red pl-4 text-3xl font-bold md:text-4xl">
      {title}
    </h1>
    <p class="mt-6 text-brand-black/60">{t('page.comingSoon')}</p>
  </section>
</BaseLayout>
