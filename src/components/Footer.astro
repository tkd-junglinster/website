---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-brand-black text-white/70">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="flex items-center gap-2 text-lg font-bold text-white">
        <span class="inline-block h-5 w-2.5 bg-brand-red"></span>
        {t('site.title')}
      </p>
      <p class="mt-1 text-sm">{t('footer.tagline')}</p>
    </div>
    <p class="text-sm">© {year} {t('site.title')}. {t('footer.rights')}</p>
  </div>
</footer>
