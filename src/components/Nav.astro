---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, localePath } from '../i18n/utils';
import type { UiKey } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links: { key: UiKey; path: string }[] = [
  { key: 'nav.home', path: '' },
  { key: 'nav.about', path: 'about' },
  { key: 'nav.join', path: 'join' },
  { key: 'nav.training', path: 'training' },
  { key: 'nav.competitions', path: 'competitions' },
  { key: 'nav.events', path: 'events' },
  { key: 'nav.news', path: 'news' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (path: string) => current === `/${lang}${path ? '/' + path : ''}`;
---

<header class="sticky top-0 z-50 bg-brand-black text-white shadow-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href={localePath(lang)} class="flex items-center gap-2 text-lg font-bold">
      <span class="inline-block h-6 w-3 bg-brand-red"></span>
      {t('site.title')}
    </a>

    <!-- Desktop navigation -->
    <ul class="hidden items-center gap-6 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={localePath(lang, l.path)}
              class:list={[
                'transition-colors hover:text-brand-red',
                isActive(l.path) && 'text-brand-red',
              ]}
            >
              {t(l.key)}
            </a>
          </li>
        ))
      }
      <li class="ml-2 border-l border-white/20 pl-4"><LanguageSwitcher /></li>
    </ul>

    <!-- Mobile menu toggle -->
    <button
      id="nav-toggle"
      class="p-2 md:hidden"
      aria-label="Menu"
      aria-controls="nav-menu"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile navigation menu -->
  <div id="nav-menu" class="hidden border-t border-white/10 md:hidden">
    <ul class="space-y-1 px-4 py-3">
      {
        links.map((l) => (
          <li>
            <a
              href={localePath(lang, l.path)}
              class:list={[
                'block py-2 transition-colors hover:text-brand-red',
                isActive(l.path) && 'text-brand-red',
              ]}
            >
              {t(l.key)}
            </a>
          </li>
        ))
      }
      <li class="mt-2 border-t border-white/10 pt-3"><LanguageSwitcher /></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const nowHidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!nowHidden));
  });
</script>
