---
import { getLangFromUrl, useTranslations, localePath } from '../i18n/utils';
import { content, links, registrationOpen } from '../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const joinHref = localePath(lang, 'join');
const home = content[lang].home;
---

<!-- News banner -->
<div class="bg-brand-red text-white">
  <p class="mx-auto max-w-6xl px-4 py-3 text-center text-sm font-medium md:text-base">
    {home.newsBanner}
  </p>
</div>

<!-- Hero -->
<section class="relative isolate">
  <img
    src="/images/hero.png"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  />
  <div
    class="absolute inset-0 bg-gradient-to-r from-brand-black/90 via-brand-black/65 to-brand-black/30"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-6xl px-4 py-24 text-white md:py-36">
    <h1 class="max-w-2xl text-4xl font-extrabold leading-tight md:text-6xl">
      {t('home.hero.title')}
    </h1>
    <p class="mt-6 max-w-xl text-lg text-white/90 md:text-xl">
      {t('home.hero.subtitle')}
    </p>
    {
      registrationOpen ? (
        <a
          href={joinHref}
          class="mt-8 inline-block rounded-md bg-brand-red px-8 py-3 font-semibold text-white transition-colors hover:bg-brand-red-dark"
        >
          {t('home.cta')}
        </a>
      ) : (
        <span class="mt-8 inline-block rounded-md bg-white/15 px-5 py-2 text-sm font-medium text-white/85 ring-1 ring-white/25">
          {home.heroStatusClosed}
        </span>
      )
    }
  </div>
</section>

<!-- Welcome -->
<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="border-l-4 border-brand-red pl-4 text-2xl font-bold md:text-3xl">
    {t('home.welcome.title')}
  </h2>
  <p class="mt-6 max-w-3xl text-lg text-brand-black/80">{t('home.welcome.body')}</p>
</section>

<!-- Join the club / season status -->
<section class="bg-brand-black/[0.03]">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="rounded-lg border-l-4 border-brand-red bg-white p-6 shadow-sm md:p-8">
      <h2 class="text-2xl font-bold md:text-3xl">{home.season.title}</h2>
      <p class="mt-3 max-w-2xl text-brand-black/80">{home.season.body}</p>
      {
        registrationOpen ? (
          <a
            href={joinHref}
            class="mt-5 inline-block rounded-md bg-brand-red px-8 py-3 font-semibold text-white transition-colors hover:bg-brand-red-dark"
          >
            {t('home.cta')}
          </a>
        ) : (
          <p class="mt-4 max-w-2xl text-sm text-brand-black/70">
            {home.season.closedNote}{' '}
            <a href={`mailto:${links.email}`} class="font-semibold text-brand-red hover:underline">
              {links.email}
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>

<!-- Key facts -->
<section class="bg-brand-black text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 md:grid-cols-3">
    {
      home.facts.map((f) => (
        <div class="border-t-4 border-brand-red pt-4">
          <p class="text-3xl font-extrabold text-brand-red">{f.stat}</p>
          <p class="mt-2 text-lg font-medium text-white/90">{f.label}</p>
        </div>
      ))
    }
  </div>
</section>
