---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EventArticle from '../../../components/EventArticle.astro';
import { getAllEventSlugs, getEventDetail } from '../../../lib/events';
import { getLangFromUrl, localePath } from '../../../i18n/utils';

export async function getStaticPaths() {
  const slugs = await getAllEventSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
if (!slug) return Astro.redirect(localePath(lang, 'calendar'));
const event = await getEventDetail(slug, lang);
if (!event) return Astro.redirect(localePath(lang, 'calendar'));
---

<BaseLayout title={event.title} description={event.summary}>
  <EventArticle event={event} />
</BaseLayout>
